#include "Resource.h"

//IDI_APP_ICON ICON "app.ico"
IDD_MAIN DIALOGEX 200, 100, 400, 159
STYLE DS_SETFONT | WS_CAPTION | WS_SYSMENU
CAPTION APP_TITLE_NORMAL
FONT 9, "Segoe UI", 0, 0, 0x1
BEGIN

LTEXT		"General", IDC_NONE, 7, 2, 30, 8
LTEXT		"", IDC_NONE, 37, 6, 356, 1, SS_ETCHEDHORZ
	LTEXT       "Path:", IDC_NONE, 21, 17, 20, 8
	EDITTEXT    IDC_PATH, 43, 15, 329, 12, ES_AUTOHSCROLL
	PUSHBUTTON	"...", IDC_PATH_BROWSE, 375, 15, 18, 13, WS_TABSTOP

LTEXT       "Video", IDC_NONE, 7, 37, 20, 8
LTEXT       "", IDC_NONE, 31, 41, 362, 1, SS_ETCHEDHORZ
	LTEXT		"Bitrate", IDC_NONE, 21, 50, 30, 8
	CONTROL		"", IDC_VIDEO_BITRATE, "msctls_trackbar32", WS_TABSTOP | TBS_TOOLTIPS, 45, 50, 348, 20
	LTEXT		"Frame rate:", IDC_NONE, 21, 72, 40, 8
	EDITTEXT	IDC_VIDEO_FRAMERATE, 64, 70, 20, 12, ES_NUMBER
	

LTEXT		"Audio", IDC_NONE, 7, 91, 20, 8
LTEXT		"", IDC_NONE, 31, 95, 362, 1, SS_ETCHEDHORZ
	CONTROL		"Capture &desktop audio", IDC_AUDIO_SYS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 21, 104, 100, 8
	CONTROL		"Capture &microphone audio", IDC_AUDIO_MIC, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 21, 116, 100, 8

PUSHBUTTON	"&Hide", IDC_HIDE, 7, 138, 50, 14
LTEXT       "", IDC_NONE, 60, 145, 112, 1, SS_ETCHEDHORZ
PUSHBUTTON		"&Pause", IDC_PAUSE_RESUME, 175, 138, 50, 14
LTEXT			"", IDC_NONE, 228, 145, 112, 1, SS_ETCHEDHORZ
PUSHBUTTON		"&Start", IDC_START_STOP, 343, 138, 50, 14

END
